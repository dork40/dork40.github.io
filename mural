#!/usr/bin/env bash
# curl -sL dork40.github.io/mural | bash    (installs the latest mural, runs again to update)
set -e
command -v pacman >/dev/null || { echo "Arch-based systems only: see https://github.com/dork40/mural"; exit 1; }
url=$(curl -fsSL https://api.github.com/repos/dork40/mural/releases/latest | grep -o 'https://[^"]*\.pkg\.tar\.zst' | head -1)
f=$(mktemp -d)/${url##*/}
curl -fsSL -o "$f" "$url" && sudo pacman -U --needed --noconfirm "$f"
